{
  "name": "aurex-network",
  "version": "0.1.0",
  "private": true,
  "description": "Aurex — a family of single-purpose Discord bots",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/core/test/*.test.js",
    "start:music": "npm -w aurex-music start",
    "deploy:music": "npm -w aurex-music run deploy",
    "start:level": "npm -w aurex-level start",
    "deploy:level": "npm -w aurex-level run deploy",
    "start:greet": "npm -w aurex-greet start",
    "deploy:greet": "npm -w aurex-greet run deploy",
    "start:ticket": "npm -w aurex-ticket start",
    "deploy:ticket": "npm -w aurex-ticket run deploy",
    "start:ping": "npm -w aurex-ping start",
    "deploy:ping": "npm -w aurex-ping run deploy",
    "start:guard": "npm -w aurex-guard start",
    "deploy:guard": "npm -w aurex-guard run deploy",
    "dev:hq": "npm -w aurex-hq run dev",
    "build:hq": "npm -w aurex-hq run build",
    "start:hq": "npm -w aurex-hq run start",
    "install:all": "npm install"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
